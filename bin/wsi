#!/usr/bin/env node --enable-source-maps
const fs = require("fs"),
  readline = require("readline");

// load runtime and core library
const ws = require("../index.js");
const wsi = new ws.Interpreter();

function interactive() {
  const rl = readline.createInterface({
    input: process.stdin,
    output: process.stdout,
    removeHistoryDuplicates: true,
    terminal: true,
  });

  rl.setPrompt("> ");
  rl.prompt();

  rl.on("line", function (line) {
    try {
      const input = line.trim();
      if (input === "exit") {
        console.log("Bye for now!");
        process.exit(0);
      } else {
        const res = wsi.evalString(input);
        console.log("=>", ws.prStr(res));
        rl.setPrompt("> ");
      }
    } catch (e) {
      console.error(e);
    }
    rl.prompt();
  }).on("close", function () {
    console.log("Bye for now!");
    process.exit(0);
  });
  process.exitCode = 0;
}

interactive();
